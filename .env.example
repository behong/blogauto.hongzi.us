# Local loopback port exposed by Docker Compose
NAVERBLOG_PORT=8765
# Optional canonical public origin, for example https://blog.example.com
# If omitted, sitemap.xml uses the hostname from the incoming request.
PUBLIC_BASE_URL=

# Toss Open API access/secret settings are loaded automatically by deploy.ps1 from
# ..\total-10shop-260514\.env.docker.cutover. Do not duplicate access credentials here.
# Configure the publisher UUID here or in that cutover file. The effective value
# is used only server-side and takes priority over any legacy admin-screen value.
TOSS_OPEN_API_PUBLISHER_ID=

# Publish history / failure logging (server-side only)
# Example: postgresql://blogauto:password@postgres:5432/blogauto
DATABASE_URL=
# Generate a long random value and send it as: Authorization: Bearer <token>
AUTOMATION_API_TOKEN=
DB_MAX_RETRIES=3

# Optional alerts. Keep the bot token server-side only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed when starting the optional cloudflared profile
CLOUDFLARE_TUNNEL_TOKEN=

# Local browser safety gate. Leave AUTOMATION_HEADLESS=false so the first
# SmartEditor verification is observable. The profile stores the user's own
# browser session locally; never commit this directory or its contents.
AUTOMATION_API_URL=http://127.0.0.1:8765
AUTOMATION_AUDIT_CSV_PATH=data/automation_history.csv
AUTOMATION_HEADLESS=false
AUTOMATION_USER_DATA_DIR=data/browser-profile
# Optional: use a user-started Chrome DevTools endpoint instead of the dedicated profile.
# AUTOMATION_CDP_URL=http://127.0.0.1:9222
# Optional: set an explicit local Chrome/Chromium executable path when auto-detection fails.
# AUTOMATION_BROWSER_EXECUTABLE=
